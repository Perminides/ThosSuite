<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>de.tmarkgraf</groupId>
	<artifactId>thossuite-app</artifactId>
	<!-- Pflichtfeld, ohne Parent nicht weglassbar. Benennt das Artefakt (JAR, jpackage-Input) und
	     sonst nichts — es gibt bewusst kein Versionskonzept. Steht nur hier; das jpackage-Plugin
	     zieht sich denselben Wert über ${project.version}. -->
	<version>1.0</version>

	<properties>
		<maven.compiler.source>25</maven.compiler.source>
		<maven.compiler.target>25</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<jackson.version>2.20.0</jackson.version>
		<!-- NICHT unter 26 zurückdrehen. Bis 25 konnte ein Fenster mit StageStyle.EXTENDED nach dem
		     Sichtbarwerden keine Eingabe mehr annehmen, bis die Maus es einmal verlassen und wieder
		     betreten hatte (JDK-8367557, in 26 behoben). JavaFX 26 ist gegen Java 24 übersetzt und
		     läuft damit auf JDK 25 — der jpackage-Grund weiter unten bleibt unberührt. -->
		<javafx.version>26</javafx.version>
		<!-- Mindestens 1.4.1 — davor kennt der Bytecode-Leser Klassendateiversion 69 (Java 25)
		     nicht und überspringt sie STILL. Die Regeln melden dann "failed to check any classes",
		     nicht etwa einen Verstoß. 1.4.2 kann zusätzlich Java 26. -->
		<archunit.version>1.4.2</archunit.version>
		<junit.version>5.11.4</junit.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.willena</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.51.1.0</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
			<classifier>win</classifier>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-graphics</artifactId>
			<version>${javafx.version}</version>
			<classifier>win</classifier>
		</dependency>

		<!-- Wird von ScenicView gebraucht -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-swing</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- Source:
		https://mvnrepository.com/artifact/org.imgscalr/imgscalr-lib -->
		<!-- Brauchen wir für den SkeletonStripper, der alle Klassen auf die Meta-Infos eindampft für eine LLM -->
		<dependency>
			<groupId>org.imgscalr</groupId>
			<artifactId>imgscalr-lib</artifactId>
			<version>4.2</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.5</version>
		</dependency>

		<dependency>
			<groupId>com.github.javaparser</groupId>
			<artifactId>javaparser-core</artifactId>
			<version>3.28.2</version>
		</dependency>

		<!-- Nur für die Architekturprüfung in src/test. Landen nicht in der Auslieferung. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>
	<build>
		<plugins>

			<!-- Führt die Architekturregeln aus (src/test/java/app/ArchitekturRegelnTest.java).
			     Achtung: Eclipse' inkrementeller Build ruft Surefire NICHT auf. Die Regeln greifen
			     bei einem echten Maven-Lauf (Run As → Maven build, Ziel test oder verify) oder
			     direkt über Run As → JUnit Test. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
			<!-- Nötig weil jpackage die exe schreibgeschützt erstellt:
			https://bugs.openjdk.org/browse/JDK-8261845 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<force>true</force>
					<filesets>
						<fileset>
							<directory>${project.build.directory}</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>

			<!-- Hält scripts (Wegwerf-/Analyse-Code) aus der ausgelieferten JAR -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<excludes>
						<exclude>scripts/**</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Dependency Plugin: Kopiert alle JARs nach target/libs -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/libs</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Maven Resources Plugin: Bereitet jpackage-input vor -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-jars-to-jpackage-input</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/jpackage-input</outputDirectory>
							<resources>
								<resource>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>
											thossuite-app-${project.version}.jar</include>
									</includes>
								</resource>
								<resource>
									<directory>${project.build.directory}/libs</directory>
									<includes>
										<include>*.jar</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- ACHTUNG: Eclipse-JDK und JAVA_HOME müssen auf JDK 25 zeigen.
		     jpackage 26 erzeugt keine Windows Application Manifests mehr (Regression,
		     vgl. JDK-8284675, ursprünglich in JDK 19 gefixt). Ohne Manifest aktiviert
		     Windows DPI-Virtualisierung und skaliert die Anwendung hoch.
		     jpackage 25 erzeugt das Manifest korrekt → kein Problem.
		     Auf JDK 26 wechseln sobald der Bug dort gefixt ist. -->
			<!-- jpackage Plugin: Erstellt die EXE -->
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.6.5</version>
				<configuration>
					<name>ThosSuite-JavaFX</name>
					<appVersion>${project.version}</appVersion>
					<vendor>TMarkgraf</vendor>
					<destination>${project.build.directory}/build</destination>

					<input>${project.build.directory}/jpackage-input</input>
					<mainJar>thossuite-app-${project.version}.jar</mainJar>
					<mainClass>app.ThosSuiteApp</mainClass>

					<type>APP_IMAGE</type>
					<icon>${project.basedir}/src/main/packaging/mondrian.ico</icon>

					<addModules>
						<addModule>javafx.controls</addModule>
						<addModule>javafx.graphics</addModule>
						<addModule>java.sql</addModule>
						<addModule>java.net.http</addModule>
						<addModule>jdk.localedata</addModule> <!-- Vollständige
						Locale-Daten. Ohne dieses Modul verwendet Java minimale
						Locale-Daten mit ',' als Tausendertrenner für de_DE, was
						in Deutschland unüblich ist. Mit jdk.localedata wird der
						übliche Punkt '.' verwendet. -->
					</addModules>

					<modulePaths>
						<modulePath>${project.build.directory}/jpackage-input</modulePath>
					</modulePaths>

					<javaOptions>
						<option>-Dprism.allowhidpi=false</option>
						<option>-Xms512M</option>
						<option>-Xmx4g</option>
						<option>-Djavafx.enablePreview=true</option>
						<option>-Dprism.lcdtext=false</option>
						<option>
							--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
					</javaOptions>

					<!-- !Später: Der Datenordner steht hier als absoluter Pfad und bindet den Build an
					     genau diesen Rechner. Für den Eigengebrauch in Ordnung, aber ein Umzug oder ein
					     zweiter Rechner bricht das gepackte Paket still — die Suite fragt dann per
					     Verzeichniswahl nach. Sauberer wäre eine Property, die beim Bauen gesetzt wird. -->
					<arguments>
						<argument>C:/Users/permi/Documents/Gedächtnis Lernen und so/ThosSuite/</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>